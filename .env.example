POSTGRES_PASSWORD=
COOKIE_SECRET=
COOKIE_SECURE=false

# Public URL the app is served at — needed to build clickable links in emails
# (e.g. the password reset link). Example: https://lmu.qlng.fr
PUBLIC_BASE_URL=

# SMTP (e.g. OVH mail). Leave empty to disable email sending (logged, not fatal).
MAIL_HOST=
MAIL_PORT=
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
